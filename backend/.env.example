# ASTRA HEALTH auth API — copy to backend/.env and set real values.
# NEVER commit .env: it is ignored by git (see repo .gitignore).

# PostgreSQL connection string used by the API and the migrate script.
# Replace USER and PASSWORD with your own local credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/astra_health

# Secret for signing JWTs and hashing refresh tokens. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# HTTP port for the API (frontend dev expects 3001 by default).
PORT=3001

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt work factor.
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For vitest only (backend/tests/setup.ts loads .env.test):
#   DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/astra_health_test

# --- AI Assistant (standalone chatbot integration) ---
# Provider kept from the original ASTRA_Health_Chatbot: Google Gemini.
# Optional. Put the real key ONLY in backend/.env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
